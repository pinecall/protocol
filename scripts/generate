#!/usr/bin/env bash
# schema/ -> python/pinecall_protocol (pydantic), typescript/src/generated (zod),
# ruby/lib/pinecall/protocol/generated (frozen tables) + ruby/sig (RBS), docs/ (the reference
# tables). Idempotent: a second run changes nothing.
set -euo pipefail
cd "$(dirname "$0")/.."

(cd python && uv run python ../generate && uv run ruff format pinecall_protocol)
