{
  "name": "@pinecall/protocol",
  "version": "0.6.6",
  "description": "The Pinecall wire: zod schemas and types generated from the protocol schema, and the log reducer",
  "license": "Apache-2.0",
  "author": "Pinecall <hello@pinecall.io>",
  "repository": { "type": "git", "url": "git+https://github.com/pinecall/protocol.git", "directory": "typescript" },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./fixtures/call-log-golden.json": "./fixtures/call-log-golden.json",
    "./fixtures/call-log-golden.state.json": "./fixtures/call-log-golden.state.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/fixtures && cp ../python/pinecall_protocol/fixtures/*.json dist/fixtures/",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./fixtures/call-log-golden.json": "./dist/fixtures/call-log-golden.json",
      "./fixtures/call-log-golden.state.json": "./dist/fixtures/call-log-golden.state.json"
    }
  }
}
