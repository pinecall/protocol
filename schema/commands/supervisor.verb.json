{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pinecall.io/protocol/commands/supervisor.verb.json",
  "title": "supervisor.verb",
  "description": "One supervise verb, from the human the door named. Each verb lands in the caller's log as its own supervisor.* entry before the session acts on it.",
