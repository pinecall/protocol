    "kind": "command",
    "type": "supervisor.verb",
    "scope": "call",
    "produces": [
      "supervisor.said",
      "supervisor.whispered",
      "supervisor.took_over",
      "supervisor.released",
      "supervisor.transferred",
      "supervisor.ended"
    ]
  },
  "$ref": "#/$defs/SupervisorVerb",
  "$defs": {
    "SupervisorVerb": {
      "type": "object",
      "description": "One supervise verb, from the human the door named.",
      "properties": {
        "by": {"$ref": "../defs.json#/$defs/Supervisor"},
        "verb": {"$ref": "../verbs.json#/$defs/Verb"}
      },
      "required": ["by", "verb"],
      "additionalProperties": false
    }
  }
}
